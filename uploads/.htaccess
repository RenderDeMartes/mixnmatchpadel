# User-uploaded frame images: serve as static files only, never execute anything.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .pl .py .cgi .sh
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|htaccess|user\.ini)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
